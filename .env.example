NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server-only
NEXT_PUBLIC_SITE_URL=https://minhtanphat.io.vn    # URL gốc của app (dùng cho link mời user & link email)

# Cấu hình gửi Email Thông báo (SMTP)
SMTP_HOST=smtp.tino.vn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@minhtanphat.io.vn
SMTP_PASS=your_email_password
SMTP_FROM="Minh Tân Phát - Quản Lý Kho" <admin@minhtanphat.io.vn>

# ==========================================
# CẤU HÌNH AI & RAG ENGINE (OMNIROUTE / DIFY / OPENAI)
# ==========================================
AI_PROVIDER=omniroute                             # "omniroute" | "dify" | "openai"
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=your_omniroute_api_key
AI_MODEL_CHAT=auto/fast
AI_MAX_TOKENS=1500
AI_MAX_HISTORY_MESSAGES=6

# Cấu hình Dify Platform (Self-hosted Port 5001 hoặc Dify Cloud)
DIFY_API_BASE_URL=http://127.0.0.1:8101/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxx
DIFY_DATASET_ID=your_dataset_uuid
DIFY_TOOLS_SECRET=mtp-dify-secret-2026
# ==========================================
# CẤU HÌNH METABASE BI & EMBEDDED ANALYTICS
# ==========================================
METABASE_SITE_URL=https://metabase.example.internal
# Chỉ dùng NEXT_PUBLIC_METABASE_SITE_URL nếu trình duyệt cần mở Studio trực tiếp.
NEXT_PUBLIC_METABASE_SITE_URL=
METABASE_SECRET_KEY=replace_with_a_long_random_embedding_secret